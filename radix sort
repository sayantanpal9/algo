
void radix(vector<pair<pair<int,int>,int>>&a){
    int n=a.size();
    {
        vector<int>op(n);
        for(auto x:a){
            int u=x.first.second;
            op[u]++;

        }
        vector<pair<pair<int,int>,int>>ok(n);
        vector<int>p(n);
        p[0]=0;
        for(int i=1;i<n;i++){
            p[i]=p[i-1]+op[i-1];
        }
        for(auto x:a){
            int i=x.first.second;
            ok[p[i]]=x;
            p[i]++;
        }
        a=ok;

    }
